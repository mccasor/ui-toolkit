{
  "name": "ui-toolkit",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build": "npm run tokens && ng build ui-toolkit",
    "test": "npm run test:tokens && ng test ui-toolkit --watch=false && npm run test:storybook",
    "storybook": "ng run ui-toolkit:storybook",
    "build-storybook": "ng run ui-toolkit:build-storybook",
    "tokens": "tsx scripts/build-tokens.ts",
    "test:tokens": "vitest run --project=tokens",
    "test:storybook": "vitest run --project=storybook"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "@angular/cdk": "^22.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.3",
    "@angular-devkit/architect": "^0.2203.0",
    "@angular-devkit/build-angular": "^22.3.0",
    "@angular-devkit/core": "^22.3.0",
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@fontsource-variable/manrope": "^5",
    "@fontsource/barlow-condensed": "^5",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/addon-vitest": "^10.6.8",
    "@storybook/angular-vite": "^10.6.8",
    "@types/node": "^22",
    "@vitest/browser-playwright": "5.1.1",
    "@vitest/coverage-v8": "5.1.1",
    "chart.js": "^4",
    "jsdom": "^31.0.0",
    "playwright": "1.65.1",
    "prettier": "^3.8.1",
    "storybook": "^10.6.8",
    "tsx": "^4",
    "typescript": "~6.0.2",
    "vite": "8.3.8",
    "vitest": "^5.0.0"
  }
}
